# Copy to .env and fill in. Never commit .env.

# Core
DJANGO_DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required behind HTTPS on a custom domain, e.g. https://quickpost.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. Leave empty for SQLite (quickpost/db.sqlite3).
# PostgreSQL example: postgres://quickpost:quickpost@localhost:5432/quickpost
DATABASE_URL=

# Redis for WebSockets across processes and for the shared cache.
# Optional in development (an in-process layer is used); required in production.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# Email. Development prints emails to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=QuickPost <no-reply@localhost>

# Accounts must confirm their email before posting, commenting or messaging.
REQUIRE_EMAIL_VERIFICATION=True

# Optional: Gemini key for the daily quote. Without it a built-in quote is shown.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Production behind a TLS-terminating proxy
# BEHIND_PROXY=True
